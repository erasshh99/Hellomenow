<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Model Attribution Chip -->
    <TextView
        android:id="@+id/tv_model_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:text="GPT-4o"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="@color/omni_primary" />

    <!-- Main Assistant Bubble -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_assistant"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- Reasoning / Thinking Accordion (Collapsible) -->
        <LinearLayout
            android:id="@+id/layout_reasoning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_badge"
            android:backgroundTint="?attr/colorSurface"
            android:layout_marginBottom="8dp"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_reasoning_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▼ Thought Process (Reasoning Tokens)"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/omni_tertiary" />

            <TextView
                android:id="@+id/tv_reasoning_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true" />

        </LinearLayout>

        <!-- Main Answer Text (Markdown formatted) -->
        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true" />

        <!-- Token Usage & Latency Footer -->
        <TextView
            android:id="@+id/tv_footer_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Action Row: Copy, Share, Retry -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btn_copy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/copy" />

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/share" />

            <ImageButton
                android:id="@+id/btn_retry"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/retry" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
