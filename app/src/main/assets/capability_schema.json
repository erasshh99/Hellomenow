{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapabilityAnalysis",
  "type": "object",
  "properties": {
    "modelId": { "type": "string" },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "visionInput": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "documentInputPdf": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "documentInputText": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "audioInput": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "audioOutput": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "imageGeneration": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "videoGeneration": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "functionCalling": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "structuredJsonOutput": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "streaming": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "systemPromptSupport": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "reasoningTokens": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "multiImagePerTurn": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "nativeFileUpload": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "webSearchTool": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "codeExecutionTool": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "longContextAbove128k": { "type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "rationale": { "type": "string" }
  },
  "required": [
    "modelId",
    "confidence",
    "visionInput",
    "documentInputPdf",
    "imageGeneration",
    "videoGeneration",
    "functionCalling",
    "streaming"
  ]
}
