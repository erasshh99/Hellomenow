<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <!-- The Pro entitlement belongs to the Play purchase on this device and must not travel. -->
        <exclude domain="sharedpref" path="island_pro.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="island_pro.xml" />
    </device-transfer>
</data-extraction-rules>
